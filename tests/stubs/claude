#!/bin/bash
# Stands in for claude in the free tests. Records calls and serves session state
# from files in $STUB_DIR.
: "${STUB_DIR:?}"
printf '%s\n' "$(printf '%q ' "$@")" >> "$STUB_DIR/calls.log"
case "${1:-}" in
  --version) echo "${STUB_VERSION:-2.1.316} (Claude Code)"; exit 0 ;;
  agents) cat "$STUB_DIR/agents.json" 2>/dev/null || echo '[]'; exit 0 ;;
  rm)
    [ -f "$STUB_DIR/rm-fail" ] && { echo "kept: stub refuses"; exit 1; }
    jq --arg i "$2" 'map(select(.id != $i))' "$STUB_DIR/agents.json" > "$STUB_DIR/a.tmp" && mv "$STUB_DIR/a.tmp" "$STUB_DIR/agents.json"
    echo "removed $2"; exit 0 ;;
  stop|respawn) echo "$1 $2"; exit 0 ;;
esac
if [ "${1:-}" = "--bg" ]; then
  [ -f "$STUB_DIR/untrusted" ] && { echo "Workspace not trusted. Run claude once."; exit 1; }
  name=spike; next=""
  for a in "$@"; do [ "$next" = name ] && name="$a"; next=""; [ "$a" = "--name" ] && next=name; done
  n=$(( $(cat "$STUB_DIR/seq" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STUB_DIR/seq"
  id=$(printf 'job%05d' "$n")
  # Save the arguments of this launch, with the prompt as the last one.
  for a in "$@"; do printf '%s\n' "$a"; done > "$STUB_DIR/launch-$id.args"
  printf '%s\n' "$PWD" > "$STUB_DIR/launch-$id.cwd"
  [ -f "$STUB_DIR/agents.json" ] || echo '[]' > "$STUB_DIR/agents.json"
  jq --arg i "$id" --arg n "$name" --arg c "$PWD" '. + [{id:$i,name:$n,kind:"background",state:"working",status:"busy",pid:1,sessionId:("s-"+$i),cwd:$c}]' "$STUB_DIR/agents.json" > "$STUB_DIR/a.tmp" && mv "$STUB_DIR/a.tmp" "$STUB_DIR/agents.json"
  echo "backgrounded · $id · $name"
  exit 0
fi
exit 0
